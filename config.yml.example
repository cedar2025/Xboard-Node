# Xboard Node Configuration
# Top-level settings are inherited by all instances. Instance overrides take precedence.

# ── Single node (simplest) ──
# panel:
#   url: "https://panel.example.com"
#   token: "your-api-key"
#   node_id: 1

# ── Multiple instances ──
# kernel:
#   type: "singbox"
#   # 本地 Trojan TCP+TLS fallback；面板热更新不会覆盖。
#   # 目标需由本机 HTTP 服务监听，h2 目标需支持 h2c。
#   fallbacks:
#     - dest: "127.0.0.1:8080"
#     - alpn: "h2"
#       dest: "127.0.0.1:8082"
# log:
#   level: "info"
# instances:
#   - panel:
#       url: "https://panel.example.com"
#       token: "api-key-1"
#       node_id: 1
#   - panel:
#       url: "https://panel.example.com"
#     machine:
#       machine_id: 2
#       token: "machine-token-2"
#     log:
#       level: "debug"   # override for this instance only
